# ============ 飞书自建应用（open.feishu.cn 开发者后台创建「企业自建应用」） ============
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx

# ---- Sink：通知目标群 chat_id（oc_ 开头；群设置 → 群信息 → 群 ID 可查） ----
FEISHU_CHAT_ID=oc_xxxxxxxx

# sink 发送方式：
#   app     = 用应用机器人 API 发送（默认，推荐；需要 im:message:send_as_bot 权限）
#   webhook = 用自定义机器人 webhook（群里添加「自定义机器人」拿 URL；只能单向出站）
FEISHU_SINK_MODE=app
# FEISHU_CUSTOM_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx

# ---- clawhip daemon（发送方向：clawhip 路由 → 桥的 /feishu sink） ----
CLAWHIP_DAEMON=http://127.0.0.1:25294

# ---- Source → 指令注入（接收方向核心，对齐 omx/clawhip 源码真实模式，规格 di-align-discord-usage-20260814） ----
# 白名单 open_id 列表（逗号分隔，如 ou_xxx,ou_yyy；open_id 见桥日志 [source] user=...）。
#   - 白名单用户的所有消息默认注入 agent（含 omx $关键词，免 ! 前缀，对齐 reply-listener「无前缀过滤」）
#   - 留空 = 全部放行（向后兼容默认，任何用户都可注入）
FEISHU_ALLOWED_OPEN_IDS=

# 非白名单用户消息处理：
#   0 = 默认忽略（严格对齐 reply-listener 授权模型：不注入、不 POST）
#   1 = 仍 POST clawhip /event 作为普通事件（feishu.message，不注入）
FEISHU_FORWARD_NON_WHITELIST=0

# 可选显式指令标记：以 COMMAND_PREFIX 开头的消息 = 强制按指令处理（仅白名单用户生效）
COMMAND_PREFIX=!

# 指令注入模式：
#   codex   = codex exec --skip-git-repo-check -C <CODEX_WORKDIR> "<指令>"（默认，推荐）
#   omx     = omx exec --skip-git-repo-check -C <CODEX_WORKDIR> "<指令>"（多一层 OMX 工作流层）
#   deliver = 优先注入「运行中」tmux 会话（clawhip deliver --session <CLAWHIP_SESSION> --prompt "<指令>"，
#             对齐 reply-listener/deliver 运行中会话语义）；deliver 不可用（无运行中会话等）时回退 exec
INJECT_MODE=codex

# 仅 INJECT_MODE=deliver 时需要：deliver 不可用时的回退 exec 方式（codex | omx）
INJECT_FALLBACK_MODE=codex

# codex/omx 执行的工作目录（建议指向你的 git 仓库根；默认取桥启动时的工作目录）
CODEX_WORKDIR=D:\repos\UltraWorker

# 显式指定可执行文件（一般留空即可，Windows 下桥会自动解析 npm shim 用 node 直调）
# CODEX_BIN=C:\path\to\codex.exe
# OMX_BIN=C:\path\to\omx

# 仅 INJECT_MODE=deliver 时需要：目标 tmux 会话名
# CLAWHIP_SESSION=omx-main

# 指令执行超时（毫秒，默认 10 分钟）
EXEC_TIMEOUT_MS=600000

# ---- 结果回推 ----
# reply = 回复原消息（im/v1/messages/:message_id/reply，对齐 Discord 回复/线程）
# chat  = 发到 FEISHU_CHAT_ID（或消息所在群）
FEISHU_RESULT_MODE=reply

# 1 = 仅响应群里 @机器人 的消息（需权限 im:message.group_at_msg）；0 = 响应群里所有消息（需 im:message.group_msg）
MENTION_REQUIRED=0

# text = 纯文本；interactive = 富文本卡片（lark_md）
FEISHU_MSG_TYPE=text

# 回推结果最大字符数（超出截断）
RESULT_MAX_CHARS=3000

# ---- 本地 sink 监听端口（clawhip slack_webhook / omx webhook 指向这里） ----
BRIDGE_PORT=8787
